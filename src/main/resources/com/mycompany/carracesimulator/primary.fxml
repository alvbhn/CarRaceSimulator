<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.Double?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.carracesimulator.PrimaryController">
   <children>
      <Label text="Car Race Simulator" />
      <Pane fx:id="racePane" prefHeight="360.0" prefWidth="200.0">
         <children>
            <Line endX="430.0" layoutX="430.0" layoutY="90.0" startX="-430.0" />
            <Line endX="430.0" layoutX="430.0" layoutY="180.0" startX="-430.0" />
            <Line endX="430.0" layoutX="430.0" layoutY="270.0" startX="-430.0" />
            <Line endX="100.0" layoutX="109.0" layoutY="180.0" rotate="90.0" scaleX="1.8" startX="-100.0" />
            <Line endX="100.0" layoutX="800.0" layoutY="180.0" rotate="90.0" scaleX="1.8" startX="-100.0" />
            <Label layoutX="117.0" layoutY="6.0" text="START" />
            <Label layoutX="810.0" layoutY="6.0" text="FINISH" />
            <Group layoutX="10.0" layoutY="25.0">
               <children>
                  <Polygon fill="RED" stroke="BLACK" strokeType="INSIDE">
                    <points>
                      <Double fx:value="0.0" />
                      <Double fx:value="20.0" />
                      <Double fx:value="80.0" />
                      <Double fx:value="20.0" />
                      <Double fx:value="90.0" />
                      <Double fx:value="28.0" />
                      <Double fx:value="90.0" />
                      <Double fx:value="42.0" />
                      <Double fx:value="0.0" />
                      <Double fx:value="42.0" />
                    </points>
                  </Polygon>
                  <Polygon fill="RED" stroke="BLACK" strokeType="INSIDE">
                    <points>
                      <Double fx:value="15.0" />
                      <Double fx:value="20.0" />
                      <Double fx:value="25.0" />
                      <Double fx:value="0.0" />
                      <Double fx:value="60.0" />
                      <Double fx:value="0.0" />
                      <Double fx:value="75.0" />
                      <Double fx:value="20.0" />
                    </points>
                  </Polygon>
                  <Rectangle arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="12.0" layoutX="25.0" layoutY="5.0" stroke="BLACK" strokeType="INSIDE" width="16.0" />
                  <Rectangle arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="12.0" layoutX="45.0" layoutY="5.0" stroke="BLACK" strokeType="INSIDE" width="16.0" />
                  <Circle fill="#222222" layoutX="20.0" layoutY="42.0" radius="9.0" stroke="BLACK" strokeType="INSIDE" />
                  <Circle fill="#222222" layoutX="70.0" layoutY="42.0" radius="9.0" stroke="BLACK" strokeType="INSIDE" />
                  <Text layoutX="42.0" layoutY="36.0" strokeType="OUTSIDE" strokeWidth="0.0" text="1" />
               </children>
            </Group>
         </children>
      </Pane>
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="12.0">
         <children>
            <Button fx:id="startButton" text="Start" />
            <Button fx:id="pauseButton" mnemonicParsing="false" text="Pause" />
            <Button fx:id="resetButton" mnemonicParsing="false" text="Reset" />
            <Label text="Speed" />
            <Slider fx:id="speedSlider" max="2.0" min="0.5" value="1.0" />
            <Label fx:id="raceMessageLabel" text="Ready to race" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
