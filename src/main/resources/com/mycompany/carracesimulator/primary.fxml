<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.carracesimulator.PrimaryController">
   <children>
      <Label text="Car Race Simulator" />
      <Pane prefHeight="360.0" prefWidth="200.0" />
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="12.0">
         <children>
            <Button fx:id="primaryButton" text="Start" />
            <Button mnemonicParsing="false" text="Pause" />
            <Button mnemonicParsing="false" text="Reset" />
            <Label text="Speed" />
            <Slider max="2.0" min="0.5" value="1.0" />
            <Label text="Ready to race" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
